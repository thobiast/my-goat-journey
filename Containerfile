FROM docker.io/library/node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS development
WORKDIR /workspace
ENV NPM_CONFIG_CACHE=/npm-cache
EXPOSE 5173
CMD ["npm", "run", "dev"]

FROM development AS server-config
ARG SITE_PREFIX
ENV SITE_PREFIX=${SITE_PREFIX}
COPY config ./config
COPY containers/nginx.conf ./containers/nginx.conf
COPY scripts/render-nginx.mjs ./scripts/render-nginx.mjs
RUN node scripts/render-nginx.mjs /nginx.conf

# Runtime packaging consumes the exact shared `build` artifact; it does not
# compile a second PWA whose generated bytes might differ from Pages output.
FROM docker.io/library/nginx:1.30.5-alpine@sha256:8f84ed99befc3891b8f329c5c202785278a2cfb7c25107d57fb2a134a3117433 AS runtime
ARG SITE_PREFIX
LABEL site.prefix=${SITE_PREFIX}
COPY --from=server-config /nginx.conf /etc/nginx/nginx.conf
COPY dist /usr/share/nginx/html${SITE_PREFIX}
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["nginx", "-g", "daemon off;"]
