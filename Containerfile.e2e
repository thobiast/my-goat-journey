# Bootstrap builds this stage from the authoritative development Containerfile.
ARG NODE_TOOLCHAIN=localhost/my-goat-journey-dev:local
FROM ${NODE_TOOLCHAIN} AS node-toolchain

FROM mcr.microsoft.com/playwright:v1.56.1-noble@sha256:42f02d323c310069b4d54c94bd91a608966a486c3492c48ae0b1cea747ec5ca2
# Keep Playwright's Noble libraries and browsers; replace its older Node/npm.
COPY --from=node-toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=node-toolchain /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN rm -f /usr/bin/node /usr/bin/nodejs /usr/bin/npm /usr/bin/npx \
    && rm -rf /usr/lib/node_modules/npm \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci --cache /npm-cache && rm -rf /npm-cache
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
CMD ["npm", "run", "e2e"]
